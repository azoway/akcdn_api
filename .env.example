# Copy to .env and fill in. Never commit .env.

HOST=127.0.0.1
PORT=8787

AKCDN_API_KEY=change-me
AKILE_EMAIL=you@example.com
AKILE_PASSWORD=your-password

# Optional. Relative paths are under the project root.
# Expired or invalid session → automatic password re-login.
SESSION_FILE=.akcdn_session.json
